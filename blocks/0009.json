{"page":9,"blocks":[{"x":0.06413,"y":0.06165,"w":0.36179,"h":0.01732,"fs":0.01455,"n":1,"k":1,"t":"微积分学导论"},{"x":0.06555,"y":0.10349,"w":0.83623,"h":0.02085,"fs":0.01751,"n":1,"k":1,"t":"予讲授，但还穿插在教材的正文部分，使学生陷入“学”与“不学”的两难境"},{"x":0.06342,"y":0.1302,"w":0.83836,"h":0.01984,"fs":0.01667,"n":1,"k":1,"t":"地，给学生带来困惑，给教学带来麻烦.本教材将改写后的实数构造理论以"},{"x":0.06342,"y":0.15641,"w":0.83765,"h":0.01984,"fs":0.01667,"n":1,"k":1,"t":"及实数完备性的几个等价定理，放入附录之中，可供对之感兴趣而又学有余"},{"x":0.06413,"y":0.18312,"w":0.83694,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"力的学生学习.当然这些内容对于理解建立在实数基础之上的极限理论，乃"},{"x":0.06413,"y":0.20933,"w":0.83694,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"至整个微积分学都有很大的帮助.本教材将原来分别编写在上、下两册的可"},{"x":0.06413,"y":0.23554,"w":0.83765,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"积常微分方程和线性微分方程两部分内容进行整合，统一纳入到上册的“微"},{"x":0.06342,"y":0.26074,"w":0.84049,"h":0.02136,"fs":0.01794,"n":1,"k":1,"t":"分方程”一章.这样有利于教学安排，节省课时，又方便学生学习理解.同时，"},{"x":0.06484,"y":0.28796,"w":0.83694,"h":0.01984,"fs":0.01667,"n":1,"k":1,"t":"由于上册没有讲授幂级数知识，所以应用幂级数求解方程的内容将放入幂"},{"x":0.06413,"y":0.31468,"w":0.80853,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"级数的应用之中讲授.本教材还纠正了《高等数学导论》中若干错漏之处."},{"x":0.11598,"y":0.34139,"w":0.78509,"h":0.01883,"fs":0.01582,"n":1,"k":1,"t":"（3）钱学森先生是中国科学技术大学近代力学系首任系主任，他对非"},{"x":0.06413,"y":0.3676,"w":0.83836,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"数学系用的微积分教材的编写有过指导性建议：既要写出从哪儿来，即数学"},{"x":0.06342,"y":0.39431,"w":0.83765,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"概念的“来龙”，也要写出到哪儿去，也就是用在什么地方，即数学知识的“去"},{"x":0.06342,"y":0.42103,"w":0.83978,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"脉”.钱老的这些意见是我们写作本书始终遵守的原则·在教材编写过程中，"},{"x":0.06342,"y":0.44774,"w":0.83765,"h":0.01883,"fs":0.01582,"n":1,"k":1,"t":"我们充分考虑学生的背景和认知水平，尽量由具体问题引入数学概念，同时"},{"x":0.06342,"y":0.47395,"w":0.83694,"h":0.01883,"fs":0.01582,"n":1,"k":1,"t":"辅以几百张图片，以使那些抽象深奥的数学概念、思想和方法变得具体、生"},{"x":0.06413,"y":0.50117,"w":0.83623,"h":0.01783,"fs":0.01497,"n":1,"k":1,"t":"动、形象和直观.对于微积分学中的概念、思想和方法的物理和几何背景与"},{"x":0.06413,"y":0.52687,"w":0.83551,"h":0.01783,"fs":0.01497,"n":1,"k":1,"t":"解释，与数学其他分支之间的联系以及理论和重要公式之间的联系都适当"},{"x":0.06271,"y":0.55308,"w":0.83907,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"地写入本教材之中，以帮助学生理解，使其不但知其然，也知其所以然.数学"},{"x":0.06271,"y":0.5803,"w":0.83907,"h":0.01883,"fs":0.01582,"n":1,"k":1,"t":"理论学习之后，本教材都有意地编排一些物理和几何甚至是生活中的具体"},{"x":0.06413,"y":0.60752,"w":0.83623,"h":0.01732,"fs":0.01455,"n":1,"k":1,"t":"应用问题，对这些问题的分析和解决，可以培养学生运用数学知识分析问题"},{"x":0.06271,"y":0.63322,"w":0.49745,"h":0.01883,"fs":0.01582,"n":1,"k":1,"t":"和解决问题的能力，激发其学习数学的兴趣."},{"x":0.11669,"y":0.66044,"w":0.78367,"h":0.01833,"fs":0.0154,"n":1,"k":1,"t":"（4）华罗庚先生是中国科学技术大学应用数学和计算技术系的首任系"},{"x":0.06413,"y":0.68615,"w":0.83623,"h":0.01883,"fs":0.01582,"n":1,"k":1,"t":"主任，他亲自写作的《高等数学》在内容的取舍和写作方法以及叙述论证的"},{"x":0.06342,"y":0.71236,"w":0.83694,"h":0.01883,"fs":0.01582,"n":1,"k":1,"t":"风格等方面始终是我们本书写作过程中模仿的楷模.我们尽量做到核心知"},{"x":0.06271,"y":0.73907,"w":0.83765,"h":0.01883,"fs":0.01582,"n":1,"k":1,"t":"识突出，理论体系脉络清晰，简繁适当，论证简洁清楚，枝节问题一笔带过，"},{"x":0.06342,"y":0.76629,"w":0.83694,"h":0.01783,"fs":0.01497,"n":1,"k":1,"t":"例题针对性强，并且分析透彻，能起到举一反三的作用，应用问题紧贴知识"},{"x":0.06342,"y":0.7925,"w":0.83623,"h":0.01783,"fs":0.01497,"n":1,"k":1,"t":"主题且分析细致.在每一章之末，专门编写本章复习.首先，将本章内容作提"},{"x":0.062,"y":0.8182,"w":0.83765,"h":0.01883,"fs":0.01582,"n":1,"k":1,"t":"纲领性的回顾，这就是华老提出的“由厚到薄”的学习过程；其次，提出一"},{"x":0.06129,"y":0.84341,"w":0.83907,"h":0.02186,"fs":0.01836,"n":1,"k":1,"t":"些与正文内容紧密相连的复习思考题，以利于学生对自已的学习掌握情况"},{"x":0.06058,"y":0.87012,"w":0.83836,"h":0.02136,"fs":0.01794,"n":1,"k":1,"t":"作检验，引导学生再“由薄到厚”.同时，本教材用许多开放式的思考题引导"},{"x":0.062,"y":0.89734,"w":0.83694,"h":0.01984,"fs":0.01667,"n":1,"k":1,"t":"学生将数学与其他自然科学以及日常生活紧密地联系起来，增强其学习兴"},{"x":0.07763,"y":0.9306,"w":0.06137,"h":0.01984,"fs":0.01667,"n":1,"k":0,"t":"·Vi·"}]}