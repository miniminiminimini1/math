{"page":5,"blocks":[{"x":0.41925,"y":0.20127,"w":0.16932,"h":0.03295,"fs":0.02768,"n":1,"k":1,"t":"总，序"},{"x":0.13515,"y":0.31619,"w":0.78793,"h":0.01833,"fs":0.0154,"n":1,"k":1,"t":"2008年，为庆祝中国科学技术大学建校五十周年，反映建校以来的办学"},{"x":0.08615,"y":0.34189,"w":0.83694,"h":0.01783,"fs":0.01497,"n":1,"k":1,"t":"理念和特色，集中展示教材建设的成果，学校决定组织编写出版代表中国科学"},{"x":0.08544,"y":0.36709,"w":0.83836,"h":0.01783,"fs":0.01497,"n":1,"k":1,"t":"技术大学教学水平的精品教材系列.在各方的共同努力下，共组织选题281"},{"x":0.08544,"y":0.3923,"w":0.67216,"h":0.01833,"fs":0.0154,"n":1,"k":1,"t":"种，经过多轮、严格的评审，最后确定.50种入选精品教材系列."},{"x":0.13729,"y":0.4175,"w":0.7858,"h":0.01833,"fs":0.0154,"n":1,"k":1,"t":"五十周年校庆精品教材系列于2008年9月纪念建校五十周年之际陆续"},{"x":0.08686,"y":0.4432,"w":0.83551,"h":0.01783,"fs":0.01497,"n":1,"k":1,"t":"出版，共出书50种，在学生、教师、校友以及高校同行中引起了很好的反响，并"},{"x":0.08544,"y":0.46841,"w":0.83694,"h":0.01783,"fs":0.01497,"n":1,"k":1,"t":"整体进入国家新闻出版总署的“十一五”国家重点图书出版规划.为继续鼓励"},{"x":0.08473,"y":0.4931,"w":0.83694,"h":0.01883,"fs":0.01582,"n":1,"k":1,"t":"教师积极开展教学研究与教学建设，结合自已的教学与科研积累编写高水平"},{"x":0.08544,"y":0.5178,"w":0.8348,"h":0.01883,"fs":0.01582,"n":1,"k":1,"t":"的教材，学校决定，将精品教材出版作为常规工作，以《中国科学技术大学精品"},{"x":0.08544,"y":0.54401,"w":0.83623,"h":0.01783,"fs":0.01497,"n":1,"k":1,"t":"教材》系列的形式长期出版，并设立专项基金给予支持.国家新闻出版总署也"},{"x":0.08544,"y":0.56972,"w":0.67145,"h":0.01682,"fs":0.01413,"n":1,"k":1,"t":"将该精品教材系列继续列入“十二五”国家重点图书出版规划."},{"x":0.13302,"y":0.59391,"w":0.78722,"h":0.01883,"fs":0.01582,"n":1,"k":1,"t":"1958年学校成立之时，教员大部分来自中国科学院的各个研究所.作为"},{"x":0.08544,"y":0.62012,"w":0.83551,"h":0.01783,"fs":0.01497,"n":1,"k":1,"t":"各个研究所的科研人员，他们到学校后保持了教学的同时又作研究的传统.同"},{"x":0.08544,"y":0.64532,"w":0.83623,"h":0.01783,"fs":0.01497,"n":1,"k":1,"t":"时，根据“全院办校，所系结合”的原则，科学院各个研究所在科研第一线工作"},{"x":0.08402,"y":0.66951,"w":0.83765,"h":0.01883,"fs":0.01582,"n":1,"k":1,"t":"的杰出科学家也参与学校的教学，为本科生授课，将最新的科研成果融入到教"},{"x":0.08402,"y":0.69472,"w":0.83836,"h":0.01883,"fs":0.01582,"n":1,"k":1,"t":"学中.虽然现在外界环境和内在条件都发生了很大变化，但学校以教学为主、"},{"x":0.08402,"y":0.71992,"w":0.83694,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"教学与科研相结合的方针没有变.正因为坚持了科学与技术相结合、理论与实"},{"x":0.08331,"y":0.74562,"w":0.83765,"h":0.01883,"fs":0.01582,"n":1,"k":1,"t":"践相结合、教学与科研相结合的方针，并形成了优良的传统，才培养出了一批"},{"x":0.08473,"y":0.77133,"w":0.2439,"h":0.01833,"fs":0.0154,"n":1,"k":1,"t":"又一批高质量的人才："},{"x":0.13302,"y":0.79603,"w":0.78651,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"学校非常重视基础课和专业基础课教学的传统，也是她特别成功的原因"},{"x":0.08402,"y":0.82072,"w":0.83551,"h":0.01984,"fs":0.01667,"n":1,"k":1,"t":"之一.当今社会，科技发展突飞猛进、科技成果日新月异，没有扎实的基础知"},{"x":0.0826,"y":0.84593,"w":0.83694,"h":0.02035,"fs":0.01709,"n":1,"k":1,"t":"识，很难在科学技术研究中作出重大贡献.建校之初，华罗庚、吴有训、严济慈"},{"x":0.08189,"y":0.87062,"w":0.83765,"h":0.02085,"fs":0.01751,"n":1,"k":1,"t":"等老一辈科学家、教育家就身体力行，亲自为本科生讲授基础课.他们以渊博"},{"x":0.08189,"y":0.89582,"w":0.83765,"h":0.02035,"fs":0.01709,"n":1,"k":1,"t":"的学识、精湛的讲课艺术、高尚的师德，带出一批又一批杰出的年轻教员，培养"},{"x":0.84183,"y":0.9306,"w":0.05924,"h":0.02085,"fs":0.01751,"n":1,"k":0,"t":".i·"}]}