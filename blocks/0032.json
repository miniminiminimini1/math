0.01497,"n":1,"k":1,"t":"可以根据需要和方便自行指定．"},{"x":0.11527,"y":0.57274,"w":0.41293,"h":0.01682,"fs":0.01413,"n":1,"k":1,"t":"例1.2.12（椭圆的隐式表达）隐式函数"},{"x":0.38302,"y":0.59744,"w":0.05426,"h":0.02236,"fs":0.01879,"n":1,"k":0,"t":"+Y²"},{"x":0.44268,"y":0.605,"w":0.17926,"h":0.01984,"fs":0.01667,"n":1,"k":0,"t":"=1 (a,b>0)"},{"x":0.34751,"y":0.61256,"w":0.04219,"h":0.02287,"fs":0.01921,"n":1,"k":0,"t":"q2"},{"x":0.3951,"y":0.61508,"w":0.04219,"h":0.01783,"fs":0.01497,"n":1,"k":0,"t":"62"},{"x":0.06697,"y":0.64078,"w":0.84262,"h":0.02186,"fs":0.01757,"n":1,"k":1,"t":"表示xOy坐标平面内以原点为中心的椭圆，显然，当α=b=1时，上述隐式方程表"},{"x":0.06768,"y":0.66851,"w":0.42358,"h":0.01732,"fs":0.01455,"n":1,"k":1,"t":"示的就是单位圆.图1.17中,a=4,b=2."},{"x":0.45476,"y":0.70278,"w":0.02941,"h":0.01581,"fs":0.01328,"n":1,"k":0,"t":"y"},{"x":0.46186,"y":0.71841,"w":0.01378,"h":0.01228,"fs":0.01032,"n":1,"k":0,"t":"2"},{"x":0.562,"y":0.79199,"w":0.01662,"h":0.01682,"fs":0.01413,"n":1,"k":0,"t":"2"},{"x":0.3674,"y":0.7925,"w":0.02728,"h":0.01581,"fs":0.01328,"n":1,"k":0,"t":"-2"},{"x":0.45547,"y":0.7925,"w":0.01875,"h":0.01732,"fs":0.01455,"n":1,"k":0,"t":"0"},{"x":0.41925,"y":0.8933,"w":0.1331,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"图1.17椭圆"},{"x":0.08118,"y":0.93312,"w":0.07415,"h":0.01883,"fs":0.01582,"n":1,"k":0,"t":"·18·"}]}