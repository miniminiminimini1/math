":0,"t":"y=f(x)"},{"x":0.0826,"y":0.48806,"w":0.46336,"h":0.01883,"fs":0.01582,"n":1,"k":0,"t":"存在cE(a,b),使得 F(c)=0,即 f(c)=r."},{"x":0.59538,"y":0.49008,"w":0.02159,"h":0.01531,"fs":0.01286,"n":1,"k":1,"t":"口"},{"x":0.12876,"y":0.51175,"w":0.55426,"h":0.02035,"fs":0.01709,"n":1,"k":0,"t":"例2.4.15证明：三次方程x²-4x²+1=0在f(a)"},{"x":0.08544,"y":0.53897,"w":0.30782,"h":0.01682,"fs":0.01413,"n":1,"k":1,"t":"区间（0，1)内至少有一个实根."},{"x":0.84964,"y":0.54603,"w":0.05071,"h":0.01934,"fs":0.01624,"n":1,"k":0,"t":"bx"},{"x":0.65717,"y":0.55056,"w":0.02017,"h":0.01581,"fs":0.01328,"n":1,"k":0,"t":"0"},{"x":0.70902,"y":0.55157,"w":0.01449,"h":0.01228,"fs":0.01032,"n":1,"k":0,"t":"a"},{"x":0.13089,"y":0.56417,"w":0.48537,"h":0.01682,"fs":0.01413,"n":1,"k":1,"t":"分析对于三次方程，有一般的求根公式.但"},{"x":0.68558,"y":0.5803,"w":0.17145,"h":0.01682,"fs":0.01413,"n":1,"k":1,"t":"图2.41介值定理"},{"x":0.08473,"y":0.58887,"w":0.53154,"h":0.01732,"fs":0.01455,"n":1,"k":1,"t":"是，一方面，求根公式比较难记；另一方面，直接由求"},{"x":0.08473,"y":0.61407,"w":0.79574,"h":0.01732,"fs":0.01455,"n":1,"k":1,"t":"根公式验证某个解在给定区间，也并非易事，因为求根公式中涉及好几重根式。"},{"x":0.13018,"y":0.63877,"w":0.21833,"h":0.01833,"fs":0.0154,"n":1,"k":1,"t":"证明考察辅助函数"},{"x":0.38444,"y":0.66145,"w":0.23537,"h":0.02186,"fs":0.01836,"n":1,"k":0,"t":"f（x）=x²-4x²+1,"},{"x":0.0826,"y":0.68917,"w":0.8412,"h":0.01883,"fs":0.01582,"n":1,"k":1,"t":"则f(x)在有界闭区间[0,1]上连续,并且f(0)=1>0,f(1)=-2<0.由零值定理"},{"x":0.0826,"y":0.71437,"w":0.83694,"h":0.01833,"fs":0.0154,"n":1,"k":1,"t":"知，至少存在一点（0,1)，使得f（)=0,即-4+1=0，所以，方程x"},{"x":0.08118,"y":0.73857,"w":0.44915,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"4x²+1=0在区间(0,1)内至少有一个实根."},{"x":0.90291,"y":0.74361,"w":0.01733,"h":0.01279,"fs":0.01074,"n":1,"k":1,"t":"口"},{"x":0.12876,"y":0.76377,"w":0.31421,"h":0.01883,"fs":0.01582,"n":1,"k":1,"t":"考虑一般奇数阶实系数多项式"},{"x":0.22961,"y":0.78595,"w":0.54361,"h":0.02438,"fs":0.01865,"n":1,"k":0,"t":"a2n+1x2n+1+a2nx2n+…+a1x+ao(a2n+1≠0)."},{"x":0.07976,"y":0.80963,"w":0.84475,"h":0.02589,"fs":0.0181,"n":1,"k":1,"t":"当x的绝对值充分大