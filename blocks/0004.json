{"page":4,"blocks":[{"x":0.42138,"y":0.14078,"w":0.13452,"h":0.02136,"fs":0.01794,"n":1,"k":1,"t":"内容简介"},{"x":0.14865,"y":0.17707,"w":0.71975,"h":0.02085,"fs":0.01435,"n":1,"k":1,"t":"本书是在中国科学技术大学高等数学教研室编写的《高等数学导论》基础之上，由"},{"x":0.10888,"y":0.19774,"w":0.76094,"h":0.02085,"fs":0.01457,"n":1,"k":1,"t":"参与微积分教学多年的教师分工编写而成的，内容结构方面得以重新组织和优化，而"},{"x":0.10959,"y":0.21841,"w":0.75952,"h":0.01984,"fs":0.01454,"n":1,"k":1,"t":"且部分过于烦琐的内容也得到了删除或简化，以适应当今工科数学教育的发展，并满"},{"x":0.10959,"y":0.23857,"w":0.72117,"h":0.02085,"fs":0.01376,"n":1,"k":1,"t":"足培养学生的要求.本书分上、下两册出版，内容包含微积分学的核心内容及其应用."},{"x":0.15007,"y":0.25923,"w":0.71975,"h":0.01934,"fs":0.01454,"n":1,"k":1,"t":"本书是上册，内容包括实数与函数、极限理论、单变量函数的微分学、单变量函数"},{"x":0.10888,"y":0.27889,"w":0.76165,"h":0.02085,"fs":0.01436,"n":1,"k":1,"t":"的积分学、微分方程等五章.本书的编写充分考虑了学生的背景和认知水平，尽量由具"},{"x":0.10959,"y":0.29955,"w":0.76023,"h":0.02085,"fs":0.01433,"n":1,"k":1,"t":"体问题引人数学概念，同时采用语言描述、公式表达、数值列表以及图形说明等多种方"},{"x":0.10817,"y":0.32022,"w":0.76236,"h":0.02085,"fs":0.01473,"n":1,"k":1,"t":"式，以使抽象深奥的数学概念、思想和方法变得具体、生动、形象和直观.为加深对概"},{"x":0.10888,"y":0.34038,"w":0.76094,"h":0.02186,"fs":0.01452,"n":1,"k":1,"t":"念、定理等的理解和掌握，书中编有丰富的例题，并有详细的解答，可给学生提供一个"},{"x":0.10888,"y":0.36155,"w":0.76094,"h":0.02085,"fs":0.01435,"n":1,"k":1,"t":"解决问题的范本；还提供了大量的习题或复习题供学生练习；另外，每章末的复习都很"},{"x":0.10888,"y":0.38423,"w":0.40867,"h":0.01883,"fs":0.01405,"n":1,"k":1,"t":"好地总结了该章的内容，以供学生参考和总结."},{"x":0.15007,"y":0.40288,"w":0.71904,"h":0.02085,"fs":0.01439,"n":1,"k":1,"t":"本书可作为理工科院校非数学专业或师范类院校数学专业的教材或教学参考书，"},{"x":0.11172,"y":0.42707,"w":0.33551,"h":0.01682,"fs":0.01401,"n":1,"k":1,"t":"也可供具有一定数学基础的读者自学."},{"x":0.09396,"y":0.46185,"w":0.25384,"h":0.01883,"fs":0.01582,"n":1,"k":1,"t":"图书在版编目（CIP）数据"},{"x":0.09325,"y":0.4931,"w":0.81847,"h":0.02388,"fs":0.01697,"n":1,"k":1,"t":"微积分学导论.上册/中国科学技术大学数学科学学院编著.一2版.一合肥：中"},{"x":0.07194,"y":0.52082,"w":0.32273,"h":0.01883,"fs":0.01582,"n":1,"k":1,"t":"国科学技术大学出版社，2015.7"},{"x":0.09325,"y":0.54451,"w":0.31066,"h":0.01984,"fs":0.01637,"n":1,"k