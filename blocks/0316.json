fs":0.01032,"n":1,"k":0,"t":"—"},{"x":0.12166,"y":0.77133,"w":0.47472,"h":0.01833,"fs":0.0154,"n":1,"k":1,"t":"(1）定解问题是否至少存在一个解,即存在性;"},{"x":0.12237,"y":0.79653,"w":0.4733,"h":0.01682,"fs":0.01413,"n":1,"k":1,"t":"(2）定解问题是否至多只有一个解，即唯一性；"},{"x":0.12166,"y":0.82123,"w":0.63807,"h":0.01682,"fs":0.01413,"n":1,"k":1,"t":"(3）解是否连续地依赖于所给初始条件和参数，即连续依赖性."},{"x":0.11882,"y":0.84492,"w":0.79503,"h":0.01883,"fs":0.01582,"n":1,"k":1,"t":"解的存在性是利用定解问题解释或预测实际过程的逻辑基础，不过不能简单"},{"x":0.07194,"y":0.86911,"w":0.83978,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"地以实际过程有解而说明定解问题一定有解，因为在建立数学模型时，需要经过一"},{"x":0.07194,"y":0.89381,"w":0.84191,"h":0.01984,"fs":0.01658,"n":1,"k":1,"t":"定的理想化和简化，以及忽略一些次要因素等程序，这就使得数学模型仅是实际过"},{"x":0.09183,"y":0.92808,"w":0.07699,"h":0.01732,"fs":0.01455,"n":1,"k":0,"t":"·302"}]}