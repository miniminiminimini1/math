{"page":8,"blocks":[{"x":0.4164,"y":0.20228,"w":0.04858,"h":0.03194,"fs":0.02683,"n":1,"k":1,"t":"前"},{"x":0.55277,"y":0.20228,"w":0.04432,"h":0.03144,"fs":0.02641,"n":1,"k":1,"t":"言"},{"x":0.14226,"y":0.31619,"w":0.78722,"h":0.02136,"fs":0.01794,"n":1,"k":1,"t":"本教材是在中国科学技术大学高等数学教研室编写的《高等数学导论》"},{"x":0.09112,"y":0.34341,"w":0.83551,"h":0.01984,"fs":0.01667,"n":1,"k":1,"t":"基础之上编写而成的.而《高等数学导论》脱胎于中国科学技术大学成立之"},{"x":0.0897,"y":0.36911,"w":0.83836,"h":0.02035,"fs":0.01709,"n":1,"k":1,"t":"初由曾肯成教授主编的《高等数学讲义》，是20世纪80年代由当时的任课"},{"x":0.0897,"y":0.39582,"w":0.83765,"h":0.01984,"fs":0.01667,"n":1,"k":1,"t":"教师集体改编而成的.这两部教材在中国科学技术大学的教学历程中都起"},{"x":0.09041,"y":0.42203,"w":0.83694,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"到了积极的作用，培养了一批又一批学子，功不可没.随着时代的发展，《高"},{"x":0.0897,"y":0.44824,"w":0.83765,"h":0.01984,"fs":0.01667,"n":1,"k":1,"t":"等数学导论》改编重版的必要性就显得越来越紧迫了.这主要表现在以下"},{"x":0.08828,"y":0.47496,"w":0.09262,"h":0.02085,"fs":0.01751,"n":1,"k":1,"t":"几点："},{"x":0.14155,"y":0.50117,"w":0.78367,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"（1）《高等数学导论》自1988年出版以来，已经二十多年了.虽然这二"},{"x":0.0897,"y":0.52738,"w":0.83836,"h":0.01984,"fs":0.01667,"n":1,"k":1,"t":"十多年中有过修改，但只是对错漏的订正.后来为了适应中国科学技术大学"},{"x":0.0897,"y":0.55359,"w":0.83907,"h":0.02035,"fs":0.01709,"n":1,"k":1,"t":"学制“五改四”的需要，教学课时和周期大大缩减，将原三册改为上、下两册"},{"x":0.09041,"y":0.5803,"w":0.83694,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"出版，但是由于种种原因教材内容和结构等基本没有变动.所以，一直以来"},{"x":0.0897,"y":0.60651,"w":0.83836,"h":0.01984,"fs":0.01667,"n":1,"k":1,"t":"我们想对《高等数学导论》从内容方面重新撰写，并从结构方面重新组织和"},{"x":0.08899,"y":0.63272,"w":0.83836,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"优化，添加一部分新内容，删除或简化一部分过于烦琐的内容，以适应今天"},{"x":0.08828,"y":0.65893,"w":0.83836,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"培养大学生的要求.在本教材中有若干定理的证明加上了星号￥，表示该证"},{"x":0.09112,"y":0.68665,"w":0.83409,"h":0.01732,"fs":0.01455,"n":1,"k":1,"t":"明利用了后面的结论或者附录中的结论，对于课时比较紧张的课堂，可以只"},{"x":0.0897,"y":0.71185,"w":0.83765,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"要求学生会利用该定理的结论即可，定理证明的细节可以跳过；还有若干小"},{"x":0.09041,"y":0.73907,"w":0.83551,"h":0.01833,"fs":0.0154,"n":1,"k":1,"t":"节加上了星号￥，表示在课时比较紧张时，可以跳过该小节内容的学习，而"},{"x":0.0897,"y":0.76478,"w":0.83765,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"不影响微积分学核心内容的学习和理解，也可以安排为课外阅读内容，由授"},{"x":0.0897,"y":0.7925,"w":0.61037,"h":0.01682,"fs":0.01413,"n":1,"k":1,"t":"课教师根据教学进度以及学生的接受能力等决定取舍."},{"x":0.14084,"y":0.8172,"w":0.78438,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"（2）《高等数学导论》包括解析几何和向量代数的内容，但现在这些内"},{"x":0.08686,"y":0.86911,"w":0.83907,"h":0.01934,"fs":0.01624,"n":1,"k":1,"t":"还有一些内容也要删除，比如实数的完备性等，由于非数学系学生对于数学"},{"x":0.08686,"y":0.89482,"w":0.83907,"h":0.01984,"fs":0.01667,"n":1,"k":1,"t":"逻辑证明的接受能力以及教学时间紧迫等原因，这些内容一般在课堂上不"}]}